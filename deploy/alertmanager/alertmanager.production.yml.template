global:
  resolve_timeout: 5m

route:
  group_by: ["alertname", "severity", "service"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  receiver: "slack-warnings"
  routes:
    - match:
        severity: critical
      receiver: "pagerduty-and-slack"
      continue: false

    - match:
        severity: warning
      receiver: "slack-warnings"
      continue: false

    - match:
        severity: info
      receiver: "slack-warnings"
      continue: false

inhibit_rules:
  - source_match:
      alertname: "ServiceDown"
      severity: "critical"
    target_match_re:
      alertname: "HighLatency|NoLogsIngested|HighErrorRate"
    equal: ["service"]

receivers:
  - name: "pagerduty-and-slack"
    {{PAGERDUTY_CONFIG}}
    {{SLACK_CONFIG}}

  - name: "slack-warnings"
    {{SLACK_CONFIG}}
