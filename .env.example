# ==============================================================================
# GovSec Shield — Modelo de Variáveis de Ambiente (.env.example)
# NUNCA inclua segredos reais neste arquivo.
# ==============================================================================

# Ambiente de execução: dev, test, staging, production
GOVSEC_ENV=dev

# Mensageria Kafka / Redpanda (Em staging/production, GOVSEC_USE_KAFKA=true é obrigatório)
GOVSEC_USE_KAFKA=false
GOVSEC_KAFKA_BOOTSTRAP=localhost:19092
GOVSEC_KAFKA_TOPIC_PREFIX=govsec

# Banco de Dados PostgreSQL (asyncpg) & Cache Redis
GOVSEC_DB_URL=postgresql+asyncpg://govsec:govsec@localhost:5432/govsec
GOVSEC_REDIS_URL=redis://localhost:6379/0

# Autenticação JWT (Obrigatório segredo seguro >= 32 chars em staging/production)
GOVSEC_JWT_SECRET=super-secret-govsec-key-change-in-production
GOVSEC_JWT_ALGORITHM=HS256
GOVSEC_JWT_EXPIRE_MINUTES=60

# Engine de Políticas OPA (Open Policy Agent)
GOVSEC_OPA_URL=http://localhost:8181/v1/data/govsec/allow

# Observabilidade & Alertas
GOVSEC_ALERTMANAGER_URL=http://localhost:9093
GOVSEC_ALERTMANAGER_CONFIG=deploy/alertmanager/alertmanager.yml
GOVSEC_SLACK_WEBHOOK_URL=
GOVSEC_SLACK_WEBHOOK_FILE=
GOVSEC_PAGERDUTY_SERVICE_KEY=
GOVSEC_PAGERDUTY_SERVICE_FILE=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

